import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

df = pd.read_excel(r'C:\Users\examp\OneDrive\Робочий стіл\data_cts_violent_and_sexual_crime.xlsx')
filtered_df = df[df['Unit of measurement'].str.strip().str.lower() == 'rate per 100,000 population']

x = filtered_df['Year']
y = filtered_df['VALUE']
coefficients = np.polyfit(x, y, 1)
polynomial = np.poly1d(coefficients)
y_fit = polynomial(x)
plt.plot(x, y_fit, color='red', label='Regression line ($b_1 = \\frac{\\Delta Y}{\\Delta X}$)')
plt.text(2005, y_fit.min(), '$b_0$', fontsize=12)
plt.axhline(0, color='black', linewidth=0.5)
plt.axvline(0, color='black', linewidth=0.5)
plt.xlim(2000, 2024)
plt.xlabel('Year')
plt.ylabel('VALUE')
plt.legend()
plt.show()
