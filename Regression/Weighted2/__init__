import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import OneHotEncoder

df = pd.read_excel(r'C:\Users\examp\OneDrive\Робочий стіл\data_cts_violent_and_sexual_crime.xlsx')
filtered_df = df[df['Unit of measurement'].str.strip().str.lower() == 'rate per 100,000 population']

house = filtered_df[['VALUE', 'Country', 'Indicator', 'Dimension', 'Category', 'Sex', 'Year']]
predictors = ['Country', 'Indicator', 'Dimension', 'Category', 'Sex']
outcome = 'VALUE'

house.loc[:, 'Year'] = house['Year'].apply(lambda d: int(str(d).split('-')[0]))
house.loc[:, 'Weight'] = house['Year'] - 2003
house.loc[:, 'Weight'] = house['Weight'].clip(lower=0)

# Encode categorical variables
encoder = OneHotEncoder(handle_unknown='ignore')
X = encoder.fit_transform(house[predictors])

house_lm = LinearRegression()
house_lm.fit(X, house[outcome])

house_wt = LinearRegression()
house_wt.fit(X, house[outcome], sample_weight=house['Weight'])

results = pd.concat([
    pd.DataFrame({'predictor': encoder.get_feature_names_out(), 'house_lm': house_lm.coef_, 'house_wt': house_wt.coef_}),
    pd.DataFrame({'predictor': ['intercept'], 'house_lm': [house_lm.intercept_], 'house_wt': [house_wt.intercept_]})
])

print(results)
